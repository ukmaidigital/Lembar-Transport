# Copy to deploy/.env. Generate APP_KEY with: docker run --rm php:8.3-cli php -r 'echo "base64:".base64_encode(random_bytes(32)).PHP_EOL;'
APP_KEY=
APP_HOST=lembartransport.id
APP_URL=https://lembartransport.id
HTTP_PORT=80
DB_DATABASE=lembar
DB_USERNAME=lembar
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
FILESYSTEM_DISK=local
LEMBAR_ADMIN_2FA_REQUIRED=true
LEMBAR_BANK_NAME=BCA
LEMBAR_BANK_NUMBER=1234567890
LEMBAR_BANK_HOLDER=PT Lembar Transport
# 1 = seed demo drivers/orders on first boot (staging only)
SEED_DEMO=0
