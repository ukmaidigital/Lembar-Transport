APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Default: SQLite (zero setup). For MySQL 8 + Redis via Docker run `scripts/dev.sh --mysql`
# (or `docker compose -f deploy/docker-compose.dev.yml up -d`) and use the commented values below.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=lembar
# DB_USERNAME=lembar
# DB_PASSWORD=secret

SESSION_DRIVER=database
# SESSION_DRIVER=redis   (with the Docker dev stack)
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Lembar Transport business settings (runtime overrides live in the settings table)
LEMBAR_GATEWAY_ENABLED=false
LEMBAR_BANK_NAME=BCA
LEMBAR_BANK_NUMBER=1234567890
LEMBAR_BANK_HOLDER=PT Lembar Transport
LEMBAR_OTP_EXPOSE=
LEMBAR_ADMIN_2FA_REQUIRED=false
LEMBAR_NOTIFICATION_DRIVER=log
LEMBAR_WEB_URL=http://localhost:3000
